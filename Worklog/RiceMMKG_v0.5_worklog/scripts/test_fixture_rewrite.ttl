@prefix rice: <http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

rice:Rice_Blast_Disease a owl:NamedIndividual, rice:Disease .
rice:Magnaporthe_Oryzae a owl:NamedIndividual, rice:Pathogen ;
    rice:causes rice:Rice_Blast_Disease .

[] a owl:Axiom ;
    owl:annotatedSource rice:Magnaporthe_Oryzae ;
    owl:annotatedProperty rice:causes ;
    owl:annotatedTarget rice:Rice_Blast_Disease .
