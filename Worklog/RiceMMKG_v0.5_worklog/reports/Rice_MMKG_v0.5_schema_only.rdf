        <rice:occursIn rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Vegetative_Stage"/>
        <rice:preventedBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Seed_Treatment"/>
