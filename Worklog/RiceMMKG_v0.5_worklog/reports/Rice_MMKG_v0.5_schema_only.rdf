    <rdfs:domain rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">observation date</rdfs:label>
  </owl:DatatypeProperty>
