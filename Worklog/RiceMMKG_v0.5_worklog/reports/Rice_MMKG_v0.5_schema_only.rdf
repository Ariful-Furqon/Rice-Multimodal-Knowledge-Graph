  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#EnvironmentalFactor">
    <rdfs:comment>A condition of the surrounding environment (e.g. humidity, temperature, rainfall, soil, nutrients) that can increase the risk of a Disease or Pest.</rdfs:comment>
    <rdfs:label xml:lang="en">Environmental Factor</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#ImageObservation">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Observation"/>
    <rdfs:comment>An Observation channel: a photograph of plant tissue (e.g. a Paddy Doctor dataset image) used for visual/ML-based classification.</rdfs:comment>
    <rdfs:label xml:lang="en">Image Observation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Symptom">
    <rdfs:comment>An observable sign on the plant that indicates the presence of a Disease or Pest.</rdfs:comment>
    <rdfs:label xml:lang="en">Symptom</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/dcat#Dataset">
    <rdfs:label>Dataset</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#GrowthStage">
    <rdfs:comment>A distinct phase in the rice plant's life cycle, from seedling to harvest.</rdfs:comment>
    <rdfs:label xml:lang="en">Growth Stage</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#SeverityLevel">
    <rdfs:comment>A categorical grading of how severe an observed condition is, used to drive recommended ManagementActions.</rdfs:comment>
    <rdfs:label xml:lang="en">Severity Level</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#HealthStatus">
    <rdfs:comment>A non-disease condition assigned to a plant observation, such as a normal or healthy sample.</rdfs:comment>
    <rdfs:label xml:lang="en">Health Status</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Treatment">
    <rdfs:comment>A specific control or prevention method applied against a Disease or Pest.</rdfs:comment>
    <rdfs:label xml:lang="en">Treatment</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Observation">
    <rdfs:comment>A recorded piece of evidence about the crop or its environment, captured through a particular modality such as an image, sensor reading, or human report.</rdfs:comment>
    <rdfs:label xml:lang="en">Observation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#ManagementAction">
    <rdfs:comment>An operational response taken in reaction to an observation, ranging from no action to immediate intervention, usually recommended by a SeverityLevel.</rdfs:comment>
    <rdfs:label xml:lang="en">Management Action</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Disease">
    <rdfs:comment>A pathological condition affecting rice plants, typically caused by a Pathogen and identified through one or more Symptoms.</rdfs:comment>
    <rdfs:label xml:lang="en">Disease</rdfs:label>
  </owl:Class>
</rdf:RDF>
