    <dcterms:bibliographicCitation xml:lang="en">CABI (2022). Bipolaris oryzae (brown spot). Crop Protection Compendium. CAB International, Wallingford, UK. / IRRI (2020). Rice Doctor: Brown Spot.</dcterms:bibliographicCitation>
    <owl:annotatedSource>
      <owl:NamedIndividual rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Bipolaris_Oryzae">
        <rdf:type rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Pathogen"/>
        <rice:causes rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Brown_Spot"/>
        <rdfs:comment>NCBI Taxonomy (TaxID 101162) confirms "Bipolaris oryzae" as the accepted scientific name, with "Cochliobolus miyabeanus" (the AGROVOC c_34512 prefLabel) and "Helminthosporium oryzae" listed as synonyms for the same organism — this independently resolves the naming ambiguity flagged during the AGROVOC-only review.</rdfs:comment>
        <rdfs:label xml:lang="en">Bipolaris Oryzae</rdfs:label>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_34512"/>
