  </owl:Axiom>
  <owl:Ontology rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG">
    <owl:versionIRI rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG/0.4"/>
    <dcterms:creator>Muhammad Ariful Furqon (ORCID: https://orcid.org/0000-0002-1031-3567)</dcterms:creator>
    <dcterms:description>Rice MMKG is a knowledge graph for rice disease and pest diagnosis, populated from the Paddy Doctor image dataset. It links diseases, pests, pathogens, symptoms, environmental factors, growth stages, and management knowledge, and separates raw dataset annotation (annotatedAs) from domain-knowledge evidence (captures/indicates). This is a minimal schema: every class holds individuals and every asserted property holds assertions -- nothing is declared ahead of the data that would populate it. See dcterms:description's sibling note on the deferred design roadmap for what was intentionally left out and why.</dcterms:description>
    <dcterms:issued>2026-08-21</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:title>Rice MMKG — Rice Multimodal Knowledge Graph</dcterms:title>
    <vann:preferredNamespacePrefix>riceMMKG</vann:preferredNamespacePrefix>
    <rdfs:comment xml:lang="en">RiceMMKG: A Multimodal Knowledge Graph and Domain Ontology for Rice Pest and Disease Identification. Every domain-level assertion is grounded in peer-reviewed agronomic literature and authoritative databases (IRRI Rice Doctor Knowledge Bank, CABI Crop Protection Compendium, EPPO Global Database, and BBPOPT), formally traceable via OWL axiom annotations (owl:Axiom with dcterms:source and dcterms:bibliographicCitation).</rdfs:comment>
    <owl:versionInfo>0.4</owl:versionInfo>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#observationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
