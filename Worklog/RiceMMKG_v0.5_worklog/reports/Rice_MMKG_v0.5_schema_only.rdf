    <dcterms:bibliographicCitation xml:lang="en">CABI (2022). Sclerophthora macrospora (downy mildew of rice / crazy top). Crop Protection Compendium. CAB International. / Ou, S. H. (1985). Rice Diseases (2nd ed.). CAB International.</dcterms:bibliographicCitation>
    <owl:annotatedSource>
      <owl:NamedIndividual rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Downy_Mildew">
        <rdf:type rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Disease"/>
        <rice:sourceDatasetLabel>downy_mildew</rice:sourceDatasetLabel>
        <rdfs:comment>Disease entity introduced from the Paddy Doctor dataset label. AGROVOC c_10450 ("downy mildews") is a genus-spanning plant-pathology concept with no host-specific narrower term and no scope note restricting it to rice; mapped as skos:closeMatch, not exactMatch, because the local entity is scoped to the rice disease observed in Paddy Doctor images while the AGROVOC concept covers downy mildew across all host plants. No causal, symptom, or treatment assertions are added until they are supported by a cited domain source.</rdfs:comment>
        <rdfs:label xml:lang="en">Downy Mildew</rdfs:label>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_10450"/>
        <rice:controlledBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Water_Management"/>
        <rice:controlledBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Fungicide_Application"/>
        <rice:controlledBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Trichoderma_Application"/>
        <rice:controlledBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Crop_Rotation"/>
        <rice:indicatedBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Yellow_Stripe"/>
        <rice:indicatedBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Excessive_Tillering"/>
        <rice:indicatedBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Stunted_Growth"/>
        <rice:indicatedBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Sterile_Panicle"/>
        <rice:recommends rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Monitoring"/>
