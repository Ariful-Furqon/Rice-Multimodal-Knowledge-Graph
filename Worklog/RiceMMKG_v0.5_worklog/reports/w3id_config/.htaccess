# Rice MMKG w3id.org redirect configuration — DRAFT, not yet submitted.
# Checkpoint C1: the w3id namespace segment and the hosting URLs below
# are PLACEHOLDERS pending a human decision. Every "rice-mmkg" path
# segment and every "PLACEHOLDER-HOST" URL must be confirmed/replaced
# before this is submitted as a PR to github.com/perma-id/w3id.org.
#
# Adapted from the official w3id.org template
# (github.com/perma-id/w3id.org/tree/master/example), which uses the
# same content-negotiation pattern this file follows.

Options -MultiViews

AddType application/rdf+xml .rdf
AddType application/rdf+xml .owl
AddType text/turtle .ttl
AddType application/n-triples .n3
AddType application/ld+json .json

RewriteEngine on

# HTML (pyLODE/Widoco documentation page — Task 5 of the ESWC plan)
RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^$ https://PLACEHOLDER-HOST/rice-mmkg/index.html [R=303,L]

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://PLACEHOLDER-HOST/rice-mmkg/Rice_MMKG.jsonld [R=303,L]

# RDF/XML (default serialisation for this ontology)
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://PLACEHOLDER-HOST/rice-mmkg/Rice_MMKG.rdf [R=303,L]

# N-Triples
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://PLACEHOLDER-HOST/rice-mmkg/Rice_MMKG.nt [R=303,L]

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^$ https://PLACEHOLDER-HOST/rice-mmkg/Rice_MMKG.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} .+
RewriteRule ^(.*)$ https://PLACEHOLDER-HOST/rice-mmkg/406.html [R=406,L]

# Default: RDF/XML
RewriteRule ^$ https://PLACEHOLDER-HOST/rice-mmkg/Rice_MMKG.rdf [R=303,L]
