# DRAFT, not merged. Phase-2 symptom additions for Rice_Blast_Disease and Brown_Spot.
# Source: Analysis and Alignment/Symptom_Inventory_2026-11.md (rows BS-n = section 3.1, BL-n = section 3.3).
# Defaults chosen for review (open questions M1-M5 of the inventory):
#   M1 atomic features (shape, centre, margin, halo, size) as separate Symptom individuals;
#   M2 the discriminating wording is in rdfs:label, since the benchmark reads labels only;
#   M3 new individuals for discriminating features; reuse only Empty_Grain (generic);
#      Leaf_Death and Seedling_Death are new and shared, as they are not disease-specific;
#   M4 signs and field patterns are left out of this draft;
#   M5 three new PlantPart individuals without an external match.
# Existing assertions (Brown_Lesion, Leaf_Spot, Wilting, ...) are left unchanged: see expert question X2.
# Comments are in our own words: no IRRI wording enters the CC BY core.
@prefix rice: <https://w3id.org/ricemmkg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ---------- new plant parts

rice:Leaf_Collar a owl:NamedIndividual, rice:PlantPart ;
    rdfs:label "leaf collar"@en ;
    rdfs:comment "Junction of the leaf blade and the leaf sheath. Added for collar blast. No Planteome match asserted yet: to be looked up live before alignment."@en .

rice:Coleoptile a owl:NamedIndividual, rice:PlantPart ;
    rdfs:label "coleoptile"@en ;
    rdfs:comment "Sheath that covers the first leaf of the seedling. Added for brown spot on seedlings. No Planteome match asserted yet: to be looked up live before alignment."@en .

rice:Glume a owl:NamedIndividual, rice:PlantPart ;
    rdfs:label "glume"@en ;
    rdfs:comment "Bract of the rice spikelet. Added for brown spot on glumes. No Planteome match asserted yet: to be looked up live before alignment."@en .


# ---------- new symptoms and their plant parts

rice:Purple_Brown_Leaf_Spot a owl:NamedIndividual, rice:Symptom ;
    rdfs:label "small dark brown to purple-brown leaf spot"@en ;
    rdfs:comment "Early brown spot lesion from tillering onward: small, round and dark brown to purple-brown, before it enlarges."@en ;
    rice:affectsPlantPart rice:Leaf_Blade .

_:d1 a owl:Axiom ;
    owl:annotatedSource rice:Purple_Brown_Leaf_Spot ;
    owl:annotatedProperty rice:affectsPlantPart ;
    owl:annotatedTarget rice:Leaf_Blade ;
    dcterms:source <http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/diseases/item/brown-spot> ;
    dcterms:bibliographicCitation "IRRI (n.d.). Brown spot. Rice Knowledge Bank fact sheet. International Rice Research Institute. http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/diseases/item/brown-spot (accessed 2026-10-20)."@en ;
    rice:evidenceType "literature-curated"@en ;
    rice:hasEvidencePassage rice:IRRI_RKB_brown-spot_p7 ;
    rice:evidencePassageCheck "LLM-reviewed" ;
    rdfs:comment "DRAFT 2026-11-07 from the symptom inventory (Analysis and Alignment/Symptom_Inventory_2026-11.md, row BS-6). Quote checked as an exact substring of the passage; awaiting curator review, after which the check becomes human-reviewed."@en .

rice:Circular_Oval_Leaf_Lesion a owl:NamedIndividual, rice:Symptom ;
    rdfs:label "circular to oval leaf lesion"@en ;
    rdfs:comment "Fully developed lesion that is round to oval in outline. IRRI uses this shape to tell brown spot from blast, whose lesions are elongated and pointed."@en ;
    rice:affectsPlantPart rice:Leaf_Blade .

_:d2 a owl:Axiom ;
    owl:annotatedSource rice:Circular_Oval_Leaf_Lesion ;
    owl:annotatedProperty rice:affectsPlantPart ;
