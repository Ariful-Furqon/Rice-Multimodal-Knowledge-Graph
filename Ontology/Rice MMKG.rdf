  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Hispa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Pest"/>
    <rice:sourceDatasetLabel>hispa</rice:sourceDatasetLabel>
    <rdfs:comment xml:lang="en">Pest entity introduced from the Paddy Doctor dataset label. Symptom, treatment and growth-stage assertions have since been added; each carries its own cited source in an owl:Axiom annotation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Damage caused by the hispa beetle Dicladispa armigera. Adults scrape the upper leaf surface; larvae mine the leaf tissue, causing white streaks and browning tips.</rdfs:comment>
    <rdfs:label xml:lang="en">Hispa</rdfs:label>
    <skos:altLabel>Dicladispa armigera</skos:altLabel>
    <rice:occursIn rdf:resource="https://w3id.org/ricemmkg#Vegetative_Stage"/>
    <rice:occursIn rdf:resource="https://w3id.org/ricemmkg#Tillering_Stage"/>
    <rice:controlledBy rdf:resource="https://w3id.org/ricemmkg#Neem_Based_Pesticide"/>
    <rice:controlledBy rdf:resource="https://w3id.org/ricemmkg#Biological_Control"/>
    <rice:controlledBy rdf:resource="https://w3id.org/ricemmkg#Insecticide_Application"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Brown_Leaf_Tip"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#White_Streak"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Leaf_Scratching"/>
    <rice:recommends rdf:resource="https://w3id.org/ricemmkg#Monitoring"/>
    <rice:eppoCode>HISPAR</rice:eppoCode>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_111238"/>
  </rdf:Description>
