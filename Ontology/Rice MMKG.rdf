  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A pathological condition affecting rice plants, typically caused by a Pathogen and identified through one or more Symptoms.</rdfs:comment>
