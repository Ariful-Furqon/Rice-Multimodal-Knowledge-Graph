  <rdf:Description rdf:about="https://w3id.org/ricemmkg#ofVariety">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#ImageObservation"/>
    <rdfs:range rdf:resource="https://w3id.org/ricemmkg#Variety"/>
    <rdfs:label xml:lang="en">of variety</rdfs:label>
    <rdfs:comment xml:lang="en">The rice variety of the plant shown in an image, as recorded by the source dataset. Asserted only where the recorded variety name could be resolved to a named cultivar.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#plantAgeDays">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#ImageObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">plant age (days)</rdfs:label>
    <rdfs:comment xml:lang="en">Age of the plant in days when the image was taken, as recorded by the source dataset. Not converted to a GrowthStage, because the stage reached at a given age depends on the variety's duration.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#sourceLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">source label</rdfs:label>
    <rdfs:comment xml:lang="en">The class label exactly as written in the source dataset, kept so that mappings coarser than the source (for example three stem borer classes) stay traceable.</rdfs:comment>
  </rdf:Description>
