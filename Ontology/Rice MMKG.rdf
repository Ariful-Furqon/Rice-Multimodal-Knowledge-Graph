  <rdf:Description rdf:nodeID="Nv070disjointvariety">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#Variety"/>
    <rdf:rest rdf:nodeID="Nv070disjointassessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Variety">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A named cultivar of rice, such as IR64. A variety inherits the crop's biology but differs in its reaction to pests, diseases and abiotic stress, which is why treatment advice can be variety-specific. Resistance and susceptibility are recorded as ResistanceAssessment individuals, one per reported assessment with its own source, population and year, because resistance holds only for the population and period a source studied and can break down, as IR64's replacement over tungro susceptibility shows. Only varieties supported by a cited source are populated.</rdfs:comment>
    <rdfs:label xml:lang="en">Variety</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#varietyOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/ricemmkg#hasVariety"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#Variety"/>
    <rdfs:range rdf:resource="https://w3id.org/ricemmkg#Plant"/>
    <rdfs:comment xml:lang="en">A cultivar of a plant species, e.g. IR64 is a variety of Oryza sativa.</rdfs:comment>
    <rdfs:label xml:lang="en">variety of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#hasVariety">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/ricemmkg#varietyOf"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#Plant"/>
    <rdfs:range rdf:resource="https://w3id.org/ricemmkg#Variety"/>
    <rdfs:comment xml:lang="en">Inverse of varietyOf.</rdfs:comment>
    <rdfs:label xml:lang="en">has variety</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#IR64">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Variety"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Semidwarf indica rice variety bred at IRRI and released in the Philippines in 1985; grown on over 10 million ha and widely planted in Indonesia. Mackill and Khush (2018) report the traits IRRI listed at release and what later field experience showed, including the tungro susceptibility that displaced it in the Philippines and Indonesia. Resistance of a variety holds for the pest populations and period a source reports; it is not a timeless property.</rdfs:comment>
    <rdfs:label xml:lang="en">IR64</rdfs:label>
    <rice:varietyOf rdf:resource="https://w3id.org/ricemmkg#Rice"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Angke">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Variety"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Indonesian rice variety developed by pyramiding bacterial blight resistance genes into IR64 (Mackill and Khush 2018).</rdfs:comment>
    <rdfs:label xml:lang="en">Angke</rdfs:label>
    <rice:varietyOf rdf:resource="https://w3id.org/ricemmkg#Rice"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Conde">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Variety"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Indonesian rice variety developed by pyramiding bacterial blight resistance genes into IR64 (Mackill and Khush 2018).</rdfs:comment>
    <rdfs:label xml:lang="en">Conde</rdfs:label>
    <rice:varietyOf rdf:resource="https://w3id.org/ricemmkg#Rice"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070var01ir64varietyo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#IR64"/>
