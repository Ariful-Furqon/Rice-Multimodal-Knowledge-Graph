  <rdf:Description rdf:about="https://w3id.org/ricemmkg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/ricemmkg/0.7.0"/>
    <owl:priorVersion rdf:resource="https://w3id.org/ricemmkg/0.6.2"/>
    <vann:preferredNamespaceUri>https://w3id.org/ricemmkg#</vann:preferredNamespaceUri>
    <dcterms:creator>Muhammad Ariful Furqon (ORCID: https://orcid.org/0000-0002-1031-3567)</dcterms:creator>
    <dcterms:creator>Natthawut Kertkeidkachorn (ORCID: https://orcid.org/0000-0003-4527-776X)</dcterms:creator>
    <dcterms:description>Rice MMKG is a knowledge graph for rice disease and pest diagnosis, populated from the Paddy Doctor image dataset. It links diseases, pests, pathogens, symptoms, environmental factors, growth stages, and management knowledge, and separates raw dataset annotation (annotatedAs) from domain-knowledge evidence (captures/indicates). This is a minimal schema: every class holds individuals and every asserted property holds assertions -- nothing is declared ahead of the data that would populate it. See dcterms:description's sibling note on the deferred design roadmap for what was intentionally left out and why.</dcterms:description>
    <dcterms:issued>2026-09-03</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:title>Rice MMKG — Rice Multimodal Knowledge Graph</dcterms:title>
    <vann:preferredNamespacePrefix>riceMMKG</vann:preferredNamespacePrefix>
    <rdfs:comment xml:lang="en">RiceMMKG: A Multimodal Knowledge Graph and Domain Ontology for Rice Pest and Disease Identification. Every domain-level assertion is grounded in peer-reviewed agronomic literature and authoritative databases (IRRI Rice Doctor Knowledge Bank, CABI Crop Protection Compendium, and EPPO Global Database), formally traceable via OWL axiom annotations (owl:Axiom with dcterms:source and dcterms:bibliographicCitation). Namespace https://w3id.org/ricemmkg# since 0.7.0-dev. Releases up to v0.6.2 used http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#; their version IRIs (https://w3id.org/ricemmkg/0.6.1, https://w3id.org/ricemmkg/0.6.2) resolve to those files.</rdfs:comment>
    <owl:versionInfo>0.7.0-dev</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Stem_Borer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Pest"/>
    <rice:controlledBy rdf:resource="https://w3id.org/ricemmkg#Biological_Control"/>
    <rice:controlledBy rdf:resource="https://w3id.org/ricemmkg#Insecticide_Application"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Dead_Tiller"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#White_Ear"/>
