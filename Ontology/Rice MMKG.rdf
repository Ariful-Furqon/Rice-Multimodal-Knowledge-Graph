  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Stunted_Growth">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Reduction in plant height; a hallmark of tungro infection in early growth stages.</rdfs:comment>
    <rdfs:label xml:lang="en">stunted growth</rdfs:label>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_4426a431"/>
