  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Downy_Mildew">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Disease"/>
    <rice:sourceDatasetLabel>downy_mildew</rice:sourceDatasetLabel>
    <rdfs:comment xml:lang="en">Disease entity introduced from the Paddy Doctor dataset label. AGROVOC c_10450 ("downy mildews") is a genus-spanning plant-pathology concept with no host-specific narrower term and no scope note restricting it to rice; mapped as skos:closeMatch, not exactMatch, because the local entity is scoped to the rice disease observed in Paddy Doctor images while the AGROVOC concept covers downy mildew across all host plants. Causal, symptom and treatment assertions have since been added; each carries its own cited source in an owl:Axiom annotation.</rdfs:comment>
    <rdfs:label xml:lang="en">Downy Mildew</rdfs:label>
    <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_10450"/>
