    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_30329"/>
    <skos:broadMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_7389"/>
    <skos:altLabel>Scirpophaga incertulas</skos:altLabel>
  </rdf:Description>
