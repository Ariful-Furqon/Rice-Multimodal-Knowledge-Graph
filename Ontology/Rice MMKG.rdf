  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Deadheart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Disease"/>
    <rice:sourceDatasetLabel>dead_heart</rice:sourceDatasetLabel>
    <rdfs:comment xml:lang="en">Paddy Doctor includes this as an image class. Modelled as a Disease individual - the condition caused by Stem Borer larvae boring into the stem - rather than as a Symptom: it is what Dead_Tiller, Reduced_Tillering and White_Ear indicate, and rice:indicatedBy is defined on Disease and Pest, not on Symptom. An earlier version of this comment asserted the opposite and contradicted the individual's own rdf:type.</rdfs:comment>
    <rdfs:label xml:lang="en">Deadheart</rdfs:label>
    <rice:recommends rdf:resource="https://w3id.org/ricemmkg#Immediate_Intervention"/>
    <rice:recommends rdf:resource="https://w3id.org/ricemmkg#Monitoring"/>
    <rice:occursIn rdf:resource="https://w3id.org/ricemmkg#Reproductive_Stage"/>
    <rice:occursIn rdf:resource="https://w3id.org/ricemmkg#Tillering_Stage"/>
    <rice:occursIn rdf:resource="https://w3id.org/ricemmkg#Vegetative_Stage"/>
