  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Leaf_Bronzing">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Tiny brown spots on the lower leaves, starting from the tip, that merge until the leaf turns orange-yellow to brown and dies; the leaf bronzing of iron toxicity (IRRI). Kept apart from Yellow_Orange_Discoloration, the tungro symptom.</rdfs:comment>
    <rdfs:label xml:lang="en">leaf bronzing</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#White_Leaf_Tip">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Tips of affected leaves turn white; a symptom of salinity (IRRI). Kept apart from Dry_Leaf_Tip and Brown_Leaf_Tip, whose colour differs.</rdfs:comment>
    <rdfs:label xml:lang="en">white leaf tips</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Chlorotic_Leaf_Patch">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Pale, yellow or yellow-white patches caused by chlorosis on some leaves; a symptom of salinity (IRRI).</rdfs:comment>
    <rdfs:label xml:lang="en">chlorotic leaf patches</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Iron_Toxicity">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#AbioticFactor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Excess ferrous iron (Fe2+) taken up by the rice plant, generally in lowland soils with permanent flooding (IRRI). Listed in the 2021 Indonesian pest-observation juknis (Kepdirjen TP No. 127/HK.310/C/5/2021, Tabel 11) as keracunan Fe (asem-aseman). Modelled as the abiotic cause of Iron_Toxicity_Disorder.</rdfs:comment>
    <rdfs:label xml:lang="en">iron toxicity</rdfs:label>
    <rice:causes rdf:resource="https://w3id.org/ricemmkg#Iron_Toxicity_Disorder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Iron_Toxicity_Disorder">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Disease"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Nutritional disorder of rice caused by iron toxicity, with the symptoms listed in the IRRI iron toxicity fact sheet. Abiotic: not caused by a pathogen or pest.</rdfs:comment>
    <rdfs:label xml:lang="en">iron toxicity disorder</rdfs:label>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Leaf_Bronzing"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Stunted_Growth"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Reduced_Tillering"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Black_Root"/>
    <rice:preventedBy rdf:resource="https://w3id.org/ricemmkg#Water_Management"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Salinity">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#AbioticFactor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Excess soluble salts in soil or irrigation water, with excess sodium uptake by the rice plant (IRRI). Listed in the 2021 Indonesian pest-observation juknis (Kepdirjen TP No. 127/HK.310/C/5/2021, Tabel 11) as keracunan garam (Na and Cl). Modelled as the abiotic cause of Salinity_Disorder.</rdfs:comment>
    <rdfs:label xml:lang="en">salinity</rdfs:label>
    <rice:causes rdf:resource="https://w3id.org/ricemmkg#Salinity_Disorder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Salinity_Disorder">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Disease"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Disorder of rice caused by salinity, with the symptoms listed in the IRRI salinity fact sheet. Abiotic: not caused by a pathogen or pest.</rdfs:comment>
    <rdfs:label xml:lang="en">salinity disorder</rdfs:label>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#White_Leaf_Tip"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Chlorotic_Leaf_Patch"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Stunted_Growth"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Reduced_Tillering"/>
    <rice:preventedBy rdf:resource="https://w3id.org/ricemmkg#Water_Management"/>
  </rdf:Description>
