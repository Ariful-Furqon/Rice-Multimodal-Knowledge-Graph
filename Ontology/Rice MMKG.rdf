  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Xanthomonas_Oryzicola">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Pathogen"/>
    <rice:eppoCode>XANTTO</rice:eppoCode>
    <rdfs:label xml:lang="en">Xanthomonas oryzae pv. oryzicola</rdfs:label>
    <rice:causes rdf:resource="https://w3id.org/ricemmkg#Bacterial_Leaf_Streak"/>
    <rdfs:comment xml:lang="en">Bacterial pathogen causing bacterial leaf streak (BLS) of rice. Distinct from X. oryzae pv. oryzae (BLB).</rdfs:comment>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_129394"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#annotatedAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/ricemmkg#annotationOf"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#Observation"/>
    <rdfs:range rdf:nodeID="Nfe9d662b10a94be4a5e4f74a22fadc48"/>
    <rdfs:comment xml:lang="en">Records the raw source-dataset label assigned to an Observation (e.g. a Paddy Doctor image), independent of the detects/detectedBy relation used for confirmed field or literature-backed detections.</rdfs:comment>
    <rdfs:comment xml:lang="en">The range is a union of Disease, HealthStatus, Pest, and Symptom because this property carries ground-truth annotations from the Paddy Doctor dataset, whose label set mixes diseases, pests, symptoms, and a healthy class in a single flat vocabulary. It records what the dataset asserts, not a classification conclusion drawn by this ontology.</rdfs:comment>
    <rdfs:label xml:lang="en">annotated as</rdfs:label>
  </rdf:Description>
