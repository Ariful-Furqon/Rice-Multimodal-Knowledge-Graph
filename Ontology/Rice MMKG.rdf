  <rdf:Description rdf:about="https://w3id.org/ricemmkg#High_Night_Temperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#EnvironmentalFactor"/>
    <rdfs:label xml:lang="en">high night temperature</rdfs:label>
    <rdfs:comment xml:lang="en">Night temperatures above 25°C; strongly associated with increased severity of bacterial panicle blight (Burkholderia glumae).</rdfs:comment>
    <rice:increaseRiskOf rdf:resource="https://w3id.org/ricemmkg#Bacterial_Panicle_Blight"/>
  </rdf:Description>
