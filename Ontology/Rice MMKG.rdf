<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG/"
     xml:base="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:riceMMKG="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG">
        <rdfs:comment>Rice Multimodal Knowledge Graph (Rice MMKG): a domain schema linking rice diseases, pests, pathogens, symptoms, environmental factors, growth stages, treatments and management actions, populated from multimodal observations (images, sensor readings, field/farmer reports). Newly populated relations for previously-unused properties (captures, detects, increaseRiskOf, occursIn, requires, vulnerableTo) are illustrative examples based on general rice agronomy/entomology knowledge and should be verified against domain literature before being relied on for reasoning or publication.</rdfs:comment>
        <owl:versionInfo>2.1 - aligned disease entities with the locally available Paddy Doctor image labels</owl:versionInfo>
    </owl:Ontology>



