  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Zinc_Deficiency">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#AbioticFactor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Insufficient supply of zinc to the rice plant. IRRI describes the deficiency and its symptoms under a single name; it is modelled here as the abiotic cause of Zinc_Deficiency_Disorder, so that abiotic causes, like pathogens, end at a Disease.</rdfs:comment>
    <rdfs:label xml:lang="en">zinc deficiency</rdfs:label>
    <rice:causes rdf:resource="https://w3id.org/ricemmkg#Zinc_Deficiency_Disorder"/>
  </rdf:Description>
