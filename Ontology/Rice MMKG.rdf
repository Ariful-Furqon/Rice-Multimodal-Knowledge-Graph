    <rice:controlledBy rdf:resource="https://w3id.org/ricemmkg#Trichoderma_Application"/>
    <rice:controlledBy rdf:resource="https://w3id.org/ricemmkg#Crop_Rotation"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Yellow_Stripe"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Excessive_Tillering"/>
