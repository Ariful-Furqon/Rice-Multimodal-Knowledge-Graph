  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Good_Agricultural_Practice">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Treatment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Combination of balanced fertilisation, appropriate plant spacing, timely planting, and field sanitation to maintain plant health.</rdfs:comment>
    <rdfs:label xml:lang="en">good agricultural practice</rdfs:label>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_9088686a"/>
  </rdf:Description>
