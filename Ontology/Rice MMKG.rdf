  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Rhizoctonia_Solani">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Pathogen"/>
    <rice:causes rdf:resource="https://w3id.org/ricemmkg#Sheath_Blight"/>
    <rdfs:comment xml:lang="en">Soil-borne basidiomycete fungus causing sheath blight of rice (IRRI Rice Knowledge Bank). Rhizoctonia solani is the anamorph name; its teleomorph Thanatephorus cucumeris (AGROVOC c_35179) names the CABI datasheet already cited for sheath blight risk factors. NCBI Taxonomy 456999, EPPO RHIZSO and AGROVOC c_33858 all use Rhizoctonia solani.</rdfs:comment>
    <rdfs:label xml:lang="en">Rhizoctonia solani</rdfs:label>
    <rice:eppoCode>RHIZSO</rice:eppoCode>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_33858"/>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_456999"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070rhizoctoniacauses">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Rhizoctonia_Solani"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#causes"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Sheath_Blight"/>
    <dcterms:source rdf:resource="http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/diseases/item/sheath-blight"/>
    <dcterms:bibliographicCitation xml:lang="en">IRRI (n.d.). Sheath blight. Rice Knowledge Bank fact sheet. International Rice Research Institute. http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/diseases/item/sheath-blight (accessed 2026-09-17).</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">literature-curated</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Nitrogen_Fertilizer_Application">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Treatment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Application of nitrogen fertilizer, with the need judged from leaf color and crop appearance (e.g. with the Leaf Color Chart): about 40-50 kg N/ha as inorganic fertilizer for every ton of additional grain yield; sources include urea, ammonium sulfate and diammonium phosphate, with farmyard manure and compost partly meeting the requirement (IRRI nitrogen fact sheet).</rdfs:comment>
    <rdfs:label xml:lang="en">nitrogen fertilizer application</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070nfertilizercontrols">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Nitrogen_Deficiency_Disorder"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#controlledBy"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Nitrogen_Fertilizer_Application"/>
    <dcterms:source rdf:resource="http://www.knowledgebank.irri.org/training/fact-sheets/nutrient-management/item/nitrogen"/>
    <dcterms:bibliographicCitation xml:lang="en">IRRI (n.d.). Nitrogen (N). Rice Knowledge Bank fact sheet (nutrient management). International Rice Research Institute. http://www.knowledgebank.irri.org/training/fact-sheets/nutrient-management/item/nitrogen (accessed 2026-09-17).</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">literature-curated</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Stem_Borer">
    <rice:causes rdf:resource="https://w3id.org/ricemmkg#Deadheart"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070stemborercausesdeadheart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Stem_Borer"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#causes"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Deadheart"/>
    <dcterms:source rdf:resource="https://irac-online.org/documents/yellow-rice-stem-borer-irm/"/>
    <dcterms:bibliographicCitation xml:lang="en">IRAC (2025). Rice Stem Borer, Scirpophaga incertulas (yellow rice stem borer): Sustainable Control Strategies in Asia. Insecticide Resistance Action Committee, May 2025, Version 2. https://irac-online.org/documents/yellow-rice-stem-borer-irm/ (accessed 2026-09-23). "The initial boring and feeding by larvae in the leaf sheath cause broad, longitudinal, whitish, discoloured areas at feeding sites [...] the central leaf whorl does not unfold, turns brownish and dries off [...] This condition is known as 'dead heart' and the affected tillers dry out without bearing panicles."</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">literature-curated</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Excessive_Tillering">
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Tiller"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070excessivetilleringpart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Excessive_Tillering"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#affectsPlantPart"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Tiller"/>
    <dcterms:source rdf:resource="https://doi.org/10.1079/cabicompendium.49243"/>
    <dcterms:bibliographicCitation xml:lang="en">CABI (2019). Sclerophthora macrospora (downy mildew). CABI Compendium. CABI Publishing. https://doi.org/10.1079/cabicompendium.49243 / Ou, S. H. (1985). Rice Diseases (2nd ed.). CAB International.</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">literature-curated</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#PathogenGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The broad group of organism a pathogen belongs to, as plant pathology uses the term: fungus, bacterium, virus, oomycete. It is a practitioner's grouping, not one taxonomic rank - NCBI places Fungi at kingdom, Bacteria at domain, Viruses at an acellular root and Oomycota at phylum - and the class exists because the most converged competency question in the elicitation (CQ-A01, proposed by five of six models and rated 5/5 by the domain expert on 2026-09-20) asks which group a pathogen belongs to. Only groups with a pathogen in them are created: the nematodes, protozoa, rickettsia and viroids named in the 2026-09-14 expert review have no individual because the knowledge graph holds no such pathogen.</rdfs:comment>
    <rdfs:label xml:lang="en">Pathogen Group</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#hasPathogenGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#Pathogen"/>
    <rdfs:range rdf:resource="https://w3id.org/ricemmkg#PathogenGroup"/>
    <rdfs:comment xml:lang="en">Relates a Pathogen to its taxonomic group. Each assertion is read off the NCBI Taxonomy lineage of that pathogen, so it is ontology-derived and carries the taxonomy record it was read from as its source.</rdfs:comment>
    <rdfs:label xml:lang="en">has pathogen group</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Fungus_Group">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PathogenGroup"/>
    <rdfs:comment xml:lang="en">Fungi (NCBI Taxonomy 4751, kingdom). The group a plant pathologist means by 'jamur'.</rdfs:comment>
    <rdfs:label xml:lang="en">Fungus</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4751"/>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_3145"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Bacterium_Group">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PathogenGroup"/>
    <rdfs:comment xml:lang="en">Bacteria (NCBI Taxonomy 2, domain).</rdfs:comment>
    <rdfs:label xml:lang="en">Bacterium</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2"/>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_765"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Virus_Group">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PathogenGroup"/>
    <rdfs:comment xml:lang="en">Viruses (NCBI Taxonomy 10239, acellular root).</rdfs:comment>
    <rdfs:label xml:lang="en">Virus</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10239"/>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_8262"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Oomycete_Group">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PathogenGroup"/>
    <rdfs:comment xml:lang="en">Oomycota (NCBI Taxonomy 4762, phylum). Water moulds are stramenopiles, not true fungi, although they cause fungus-like diseases and are managed as such - which is the distinction this class exists to keep.</rdfs:comment>
    <rdfs:label xml:lang="en">Oomycete</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4762"/>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_35506"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Bipolaris_Oryzae">
    <rice:hasPathogenGroup rdf:resource="https://w3id.org/ricemmkg#Fungus_Group"/>
  </rdf:Description>
