  <rdf:Description rdf:nodeID="Nv070disjointplantpart">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:rest rdf:nodeID="Nv070disjointtransmissionmode"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#TransmissionMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The manner in which a vector acquires, retains and transmits a pathogen (e.g. non-persistent, semi-persistent, persistent). Only modes supported by a cited source are populated.</rdfs:comment>
    <rdfs:label xml:lang="en">Transmission Mode</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#hasTransmissionMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#Pathogen"/>
    <rdfs:range rdf:resource="https://w3id.org/ricemmkg#TransmissionMode"/>
    <rdfs:comment xml:lang="en">Relates a vector-borne pathogen to its mode of transmission. Asserted per pathogen, which holds only while the source reports the same mode for all of its vectors; a pathogen whose mode differs by vector would need the vector-pathogen pair modelled instead.</rdfs:comment>
    <rdfs:label xml:lang="en">has transmission mode</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Semi_Persistent">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#TransmissionMode"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Semi-persistent transmission: the vector acquires the pathogen by feeding on an infected plant and retains it only for a limited period (days), after which it must feed on an infected plant again to transmit. No AGROVOC or OLS concept exists for this mode, so it is kept local.</rdfs:comment>
    <rdfs:label xml:lang="en">semi-persistent</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070disjointtransmissionmode">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#TransmissionMode"/>
    <rdf:rest rdf:nodeID="Nv070disjointmanagementcategory"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070tm01rtbvsemipersistent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Rice_Tungro_Bacilliform_Virus"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#hasTransmissionMode"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Semi_Persistent"/>
    <dcterms:source rdf:resource="https://doi.org/10.3390/v14102258"/>
    <dcterms:bibliographicCitation xml:lang="en">Wang, P., Liu, J., Lyu, Y., Huang, Z., Zhang, X., Sun, B., Li, P., Jing, X., Li, H., &amp; Zhang, C. (2022). A Review of Vector-Borne Rice Viruses. Viruses, 14(10), 2258. https://doi.org/10.3390/v14102258</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">literature-curated</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070tm02rtsvsemipersistent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Rice_Tungro_Spherical_Virus"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#hasTransmissionMode"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Semi_Persistent"/>
    <dcterms:source rdf:resource="https://doi.org/10.3390/v14102258"/>
    <dcterms:bibliographicCitation xml:lang="en">Wang, P., Liu, J., Lyu, Y., Huang, Z., Zhang, X., Sun, B., Li, P., Jing, X., Li, H., &amp; Zhang, C. (2022). A Review of Vector-Borne Rice Viruses. Viruses, 14(10), 2258. https://doi.org/10.3390/v14102258</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">literature-curated</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#ManagementCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A category of pest and disease control method (chemical, biological, cultural, host plant resistance). Category names follow AGROVOC's narrower concepts of 'control methods' (c_5728).</rdfs:comment>
    <rdfs:label xml:lang="en">Management Category</rdfs:label>
    <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_5728"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#hasManagementCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#Treatment"/>
    <rdfs:range rdf:resource="https://w3id.org/ricemmkg#ManagementCategory"/>
    <rdfs:comment xml:lang="en">Relates a Treatment to its control-method category. Asserted only where a source places the treatment in one category; treatments that span several (e.g. seed treatment with fungicide or hot water) are left uncategorised.</rdfs:comment>
    <rdfs:label xml:lang="en">has management category</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070disjointmanagementcategory">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#ManagementCategory"/>
    <rdf:rest rdf:nodeID="Nv070disjointabioticfactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Chemical_Control_Category">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#ManagementCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Control of pests or diseases with synthetic pesticides (insecticides, fungicides, bactericides).</rdfs:comment>
    <rdfs:label xml:lang="en">chemical control</rdfs:label>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_1514"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Biological_Control_Category">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#ManagementCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Control using biological agents such as natural enemies or micro-organisms (AGROVOC definition, after FAO &amp; WHO 2017).</rdfs:comment>
    <rdfs:label xml:lang="en">biological control (category)</rdfs:label>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_918"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Cultural_Control_Category">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#ManagementCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Manipulation of the agroecosystem, such as cropping pattern or field hygiene, that makes it less suitable for pests and diseases (AGROVOC definition, after Gabryś &amp; Kordan 2022).</rdfs:comment>
    <rdfs:label xml:lang="en">cultural control</rdfs:label>
    <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_2020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Host_Plant_Resistance_Category">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#ManagementCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Intentional use of resistant crop cultivars to reduce the impact of pests or diseases (AGROVOC definition, after Stout 2014). AGROVOC files the concept under biological properties rather than control methods, hence closeMatch.</rdfs:comment>
    <rdfs:label xml:lang="en">host plant resistance</rdfs:label>
    <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_331556"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070mc01insecticideapplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Insecticide_Application"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#hasManagementCategory"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Chemical_Control_Category"/>
    <dcterms:source rdf:resource="http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/insects/item/planthopper"/>
    <dcterms:bibliographicCitation xml:lang="en">IRRI (n.d.). Planthopper. Rice Knowledge Bank fact sheet. International Rice Research Institute. http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/insects/item/planthopper (accessed 2026-09-15).</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">literature-curated</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070mc02biologicalcontrol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Biological_Control"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#hasManagementCategory"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Biological_Control_Category"/>
    <dcterms:source rdf:resource="http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/insects/item/planthopper"/>
    <dcterms:bibliographicCitation xml:lang="en">IRRI (n.d.). Planthopper. Rice Knowledge Bank fact sheet. International Rice Research Institute. http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/insects/item/planthopper (accessed 2026-09-15).</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">literature-curated</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070mc03trichodermaapplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Trichoderma_Application"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#hasManagementCategory"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Biological_Control_Category"/>
    <dcterms:source rdf:resource="http://aims.fao.org/aos/agrovoc/c_918"/>
    <dcterms:bibliographicCitation xml:lang="en">FAO. AGROVOC Multilingual Thesaurus, concept c_918 'biological control', definition adapted from FAO &amp; WHO (2017), Code of Hygienic Practice for Fresh Fruits and Vegetables, CXS 53-2003. Retrieved via the AGROVOC REST API on 2026-09-15.</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">ontology-derived</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070mc04resistantvariety">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Resistant_Variety"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#hasManagementCategory"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Host_Plant_Resistance_Category"/>
    <dcterms:source rdf:resource="http://aims.fao.org/aos/agrovoc/c_331556"/>
    <dcterms:bibliographicCitation xml:lang="en">FAO. AGROVOC Multilingual Thesaurus, concept c_331556 'host plant resistance', definition adapted from Stout, M. J. (2014), Host-plant resistance in pest management, in Integrated Pest Management, ed. D. P. Abrol, Academic Press, 1-21. Retrieved via the AGROVOC REST API on 2026-09-15.</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">ontology-derived</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070mc05croprotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Crop_Rotation"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#hasManagementCategory"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Cultural_Control_Category"/>
    <dcterms:source rdf:resource="http://aims.fao.org/aos/agrovoc/c_2020"/>
    <dcterms:bibliographicCitation xml:lang="en">FAO. AGROVOC Multilingual Thesaurus, concept c_2020 'cultural control', definition adapted from Gabryś, B. &amp; Kordan, B. (2022), Cultural control and other non-chemical methods, in Insect Pests of Potato (2nd ed.), Academic Press, 297-314. Retrieved via the AGROVOC REST API on 2026-09-15.</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">ontology-derived</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070mc06cropsanitation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/ricemmkg#Crop_Sanitation"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/ricemmkg#hasManagementCategory"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/ricemmkg#Cultural_Control_Category"/>
    <dcterms:source rdf:resource="http://aims.fao.org/aos/agrovoc/c_2020"/>
    <dcterms:bibliographicCitation xml:lang="en">FAO. AGROVOC Multilingual Thesaurus, concept c_2020 'cultural control', definition adapted from Gabryś, B. &amp; Kordan, B. (2022), Cultural control and other non-chemical methods, in Insect Pests of Potato (2nd ed.), Academic Press, 297-314. Retrieved via the AGROVOC REST API on 2026-09-15.</dcterms:bibliographicCitation>
    <rice:evidenceType xml:lang="en">ontology-derived</rice:evidenceType>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#AbioticFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A non-living cause of a rice disorder, such as the deficiency or excess of a nutrient or other substance. Like a Pathogen, an AbioticFactor causes a Disease. Only factors supported by a cited source are populated; so far these are nutrient deficiencies (N, P, K, Zn) and, on the excess side, iron toxicity and salinity.</rdfs:comment>
    <rdfs:label xml:lang="en">Abiotic Factor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070pathogenorabioticfactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="Nv070pathogenorabioticfactor1"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070pathogenorabioticfactor1">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#Pathogen"/>
    <rdf:rest rdf:nodeID="Nv070pathogenorabioticfactor2"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070pathogenorabioticfactor2">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#AbioticFactor"/>
    <rdf:rest rdf:nodeID="Nv070pathogenorabioticfactor3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070pathogenorabioticfactor3">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#Pest"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070disjointabioticfactor">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#AbioticFactor"/>
    <rdf:rest rdf:nodeID="Nv070disjointvariety"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Zinc_Fertilizer_Application">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Treatment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Application of zinc fertilizer: 10-25 kg ZnSO4.H2O or 20-40 kg ZnSO4.7H2O per ha on the soil surface, or dipping seedling roots in a 2-4% ZnO suspension before planting (IRRI zinc fact sheet).</rdfs:comment>
    <rdfs:label xml:lang="en">zinc fertilizer application</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Root">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The root of the rice plant.</rdfs:comment>
    <rdfs:label xml:lang="en">root</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0009005"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Stem">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The stem (culm) of the rice plant; PO lists culm as an exact synonym.</rdfs:comment>
    <rdfs:label xml:lang="en">stem</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0009047"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Yellowish_Green_Leaf">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Small, yellowish-green leaves; a symptom of nitrogen deficiency (IRRI: "small yellowish green leaves"). Kept apart from Yellow_Leaf, whose colour differs.</rdfs:comment>
    <rdfs:label xml:lang="en">yellowish-green leaves</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Dark_Green_Erect_Leaf">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Dark green plants with erect leaves; a symptom of phosphorus deficiency (IRRI: "stunted dark green plants with erect leaves").</rdfs:comment>
    <rdfs:label xml:lang="en">dark green erect leaves</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Thin_Spindly_Stem">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Thin and spindly stems; a symptom of phosphorus deficiency (IRRI).</rdfs:comment>
    <rdfs:label xml:lang="en">thin, spindly stems</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Stem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Delayed_Maturity">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The crop matures later than normal; reported for phosphorus deficiency (with no flowering at all when severe) and for zinc deficiency (IRRI).</rdfs:comment>
    <rdfs:label xml:lang="en">delayed maturity</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Whole_Plant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Yellowish_Brown_Leaf_Margin">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Yellowish-brown leaf margins on otherwise dark green plants; a symptom of potassium deficiency, which IRRI notes can be confused with tungro.</rdfs:comment>
    <rdfs:label xml:lang="en">yellowish-brown leaf margins</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Necrotic_Leaf_Tip_Margin">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Older leaves with necrotic tips and margins; a symptom of potassium deficiency (IRRI). Kept apart from Dry_Leaf_Tip: necrosis of tips and margins is not the same as a dry tip.</rdfs:comment>
    <rdfs:label xml:lang="en">necrotic leaf tips and margins</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Black_Root">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Unhealthy or black roots; a symptom of potassium deficiency (IRRI).</rdfs:comment>
    <rdfs:label xml:lang="en">black roots</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Root"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Lodging">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Plants fall over (lodge) more than normal; reported as "greater lodging" under potassium deficiency (IRRI).</rdfs:comment>
    <rdfs:label xml:lang="en">lodging</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Whole_Plant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Dusty_Brown_Spot">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Dusty brown spots on the upper leaves; a symptom of zinc deficiency, which IRRI notes resembles sulfur and iron deficiency and iron toxicity.</rdfs:comment>
    <rdfs:label xml:lang="en">dusty brown spots on upper leaves</rdfs:label>
    <rice:affectsPlantPart rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Nitrogen_Deficiency">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#AbioticFactor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Insufficient supply of nitrogen to the rice plant. IRRI describes the deficiency and its symptoms under a single name; it is modelled here as the abiotic cause of Nitrogen_Deficiency_Disorder, so that abiotic causes, like pathogens, end at a Disease.</rdfs:comment>
    <rdfs:label xml:lang="en">nitrogen deficiency</rdfs:label>
    <rice:causes rdf:resource="https://w3id.org/ricemmkg#Nitrogen_Deficiency_Disorder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Nitrogen_Deficiency_Disorder">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Disease"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Nutritional disorder of rice caused by nitrogen deficiency, with the symptoms listed in the IRRI nitrogen fact sheet. Abiotic: not caused by a pathogen or pest.</rdfs:comment>
    <rdfs:label xml:lang="en">nitrogen deficiency disorder</rdfs:label>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Stunted_Growth"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Yellowish_Green_Leaf"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Reduced_Tillering"/>
    <rice:controlledBy rdf:resource="https://w3id.org/ricemmkg#Nitrogen_Fertilizer_Application"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Phosphorus_Deficiency">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#AbioticFactor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Insufficient supply of phosphorus to the rice plant. IRRI describes the deficiency and its symptoms under a single name; it is modelled here as the abiotic cause of Phosphorus_Deficiency_Disorder, so that abiotic causes, like pathogens, end at a Disease.</rdfs:comment>
    <rdfs:label xml:lang="en">phosphorus deficiency</rdfs:label>
    <rice:causes rdf:resource="https://w3id.org/ricemmkg#Phosphorus_Deficiency_Disorder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Phosphorus_Deficiency_Disorder">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Disease"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Nutritional disorder of rice caused by phosphorus deficiency, with the symptoms listed in the IRRI phosphorus fact sheet. Abiotic: not caused by a pathogen or pest.</rdfs:comment>
    <rdfs:label xml:lang="en">phosphorus deficiency disorder</rdfs:label>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Stunted_Growth"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Dark_Green_Erect_Leaf"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Reduced_Tillering"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Thin_Spindly_Stem"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Delayed_Maturity"/>
    <rice:indicatedBy rdf:resource="https://w3id.org/ricemmkg#Empty_Grain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Potassium_Deficiency">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#AbioticFactor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Insufficient supply of potassium to the rice plant. IRRI describes the deficiency and its symptoms under a single name; it is modelled here as the abiotic cause of Potassium_Deficiency_Disorder, so that abiotic causes, like pathogens, end at a Disease.</rdfs:comment>
    <rdfs:label xml:lang="en">potassium deficiency</rdfs:label>
    <rice:causes rdf:resource="https://w3id.org/ricemmkg#Potassium_Deficiency_Disorder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Potassium_Deficiency_Disorder">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#Disease"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Nutritional disorder of rice caused by potassium deficiency, with the symptoms listed in the IRRI potassium fact sheet. Abiotic: not caused by a pathogen or pest.</rdfs:comment>
    <rdfs:label xml:lang="en">potassium deficiency disorder</rdfs:label>
