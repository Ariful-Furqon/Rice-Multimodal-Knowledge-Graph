  <rdf:Description rdf:nodeID="Nv070disjointassessment">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#ResistanceAssessment"/>
    <rdf:rest rdf:nodeID="Nv070disjointlevel"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070disjointlevel">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#ResistanceLevel"/>
    <rdf:rest rdf:nodeID="Nv070disjointpathogengroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nv070disjointpathogengroup">
    <rdf:first rdf:resource="https://w3id.org/ricemmkg#PathogenGroup"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#ResistanceAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">One reported assessment of a variety's reaction to a disease, disorder or pest: the variety, the target, the graded reaction, and where known the tested biotype or race, the population's origin and the year of the report. Each assessment carries its own dcterms:source, citation and evidence type. Assessments are not merged: two sources that grade the same variety differently are kept side by side, and a resistance that later broke down shows as assessments with different years.</rdfs:comment>
    <rdfs:label xml:lang="en">Resistance Assessment</rdfs:label>
  </rdf:Description>
