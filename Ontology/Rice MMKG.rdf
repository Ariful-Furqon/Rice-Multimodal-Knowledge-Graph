  <rdf:Description rdf:about="https://w3id.org/ricemmkg#PlantPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An organ or region of the rice plant on which a Symptom is observed.</rdfs:comment>
    <rdfs:label xml:lang="en">Plant Part</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#affectsPlantPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#Symptom"/>
    <rdfs:range rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdfs:comment xml:lang="en">Relates a Symptom to the plant part on which it appears. Asserted per symptom, not per disease-symptom pair.</rdfs:comment>
    <rdfs:label xml:lang="en">affects plant part</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#partOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdfs:range rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdfs:comment xml:lang="en">Relates a plant part to the larger plant part it belongs to. Asserted only where the Plant Ontology records a part_of relation.</rdfs:comment>
    <rdfs:label xml:lang="en">part of</rdfs:label>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Whole_Plant">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The entire rice plant; used for symptoms that are not confined to a single organ.</rdfs:comment>
    <rdfs:label xml:lang="en">whole plant</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Tiller">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">A shoot arising from the base of the rice plant. Aligned to PO basal axillary shoot system, of which tiller is a narrow synonym.</rdfs:comment>
    <rdfs:label xml:lang="en">tiller</rdfs:label>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0005001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Leaf">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">A leaf of the rice plant, made up of the leaf blade and the leaf sheath.</rdfs:comment>
    <rdfs:label xml:lang="en">leaf</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0025034"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Leaf_Blade">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The flattened upper part of the rice leaf (leaf lamina).</rdfs:comment>
    <rdfs:label xml:lang="en">leaf blade</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0020039"/>
    <rice:partOf rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Leaf_Sheath">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The lower, tubular part of the rice leaf that wraps around the stem.</rdfs:comment>
    <rdfs:label xml:lang="en">leaf sheath</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0020104"/>
    <rice:partOf rdf:resource="https://w3id.org/ricemmkg#Leaf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Panicle">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The rice inflorescence that bears the spikelets and grains.</rdfs:comment>
    <rdfs:label xml:lang="en">panicle</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0030123"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Panicle_Neck">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The base of the panicle where it joins the culm; the site of neck blast. No Plant Ontology term exists for it, so it is kept local.</rdfs:comment>
    <rdfs:label xml:lang="en">panicle neck</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ricemmkg#Grain">
    <rdf:type rdf:resource="https://w3id.org/ricemmkg#PlantPart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The rice grain. Aligned to PO caryopsis fruit, which denotes the dehulled grain, hence closeMatch.</rdfs:comment>
    <rdfs:label xml:lang="en">grain</rdfs:label>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0030104"/>
  </rdf:Description>
