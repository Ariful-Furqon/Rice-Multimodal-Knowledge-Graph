# DRAFT, not merged. 0.9.0-dev symptom additions for Rice_Tungro_Disease and Bacterial_Leaf_Blight.
# Source: Analysis and Alignment/Symptom_Inventory_2026-11.md (TU-n = section 3.4, BLB-n = section 3.9).
# Same choices as the blast and brown spot rows merged in 0.8.0:
#   one Symptom per visual feature, the discriminating wording in rdfs:label;
#   new individuals for discriminating features; reuse only generic ones
#   (Grain_Discoloration for tungro, Seedling_Death for BLB);
#   signs, field patterns and ambiguous rows left out (tungro: delayed flowering, patchy
#   occurrence, leafhoppers; BLB: bacterial ooze);
#   no new PlantPart.
# Existing assertions are left unchanged. Comments are in our own words: no IRRI wording.
@prefix rice: <https://w3id.org/ricemmkg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ---------- new symptoms and their plant parts

rice:Tip_Down_Leaf_Discoloration a owl:NamedIndividual, rice:Symptom ;
    rdfs:label "discoloration spreading from leaf tip downward"@en ;
    rdfs:comment "Yellow to orange-yellow discoloration that starts at the leaf tip and extends down the blade, as described for tungro."@en ;
    rice:affectsPlantPart rice:Leaf_Blade .

_:d1 a owl:Axiom ;
    owl:annotatedSource rice:Tip_Down_Leaf_Discoloration ;
    owl:annotatedProperty rice:affectsPlantPart ;
    owl:annotatedTarget rice:Leaf_Blade ;
    dcterms:source <http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/diseases/item/tungro> ;
    dcterms:bibliographicCitation "IRRI (n.d.). Tungro. Rice Knowledge Bank fact sheet. International Rice Research Institute. http://www.knowledgebank.irri.org/training/fact-sheets/pest-management/diseases/item/tungro (accessed 2026-10-20)."@en ;
    rice:evidenceType "literature-curated"@en ;
    rice:hasEvidencePassage rice:IRRI_RKB_tungro_p13 ;
    rice:evidencePassageCheck "LLM-reviewed" ;
    rdfs:comment "DRAFT 2026-11-07 from the symptom inventory (Analysis and Alignment/Symptom_Inventory_2026-11.md, row TU-2). Awaiting curator review, after which the check becomes human-reviewed."@en .

