  <rdf:Description rdf:about="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Rice_Bug">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Pest"/>
    <rice:controlledBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Insecticide_Application"/>
    <rice:indicatedBy rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Empty_Grain"/>
    <rice:occursIn rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Flowering_Stage"/>
    <rice:occursIn rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Maturity_Stage"/>
    <rice:recommends rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Insecticide_Application"/>
    <rdfs:comment xml:lang="en">Leptocorisa oratorius (slender rice bug / paddy bug). Nymphs and adults feed on developing grains causing empty grains and discoloration.</rdfs:comment>
    <rdfs:label xml:lang="en">Rice Bug</rdfs:label>
    <rice:eppoCode>LEPTOR</rice:eppoCode>
  </rdf:Description>
