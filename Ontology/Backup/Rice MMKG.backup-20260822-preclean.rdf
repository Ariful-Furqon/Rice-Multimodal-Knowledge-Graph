    <rice:occursIn rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Vegetative_Stage"/>
    <rice:recommends rdf:resource="http://www.semanticweb.org/arifu/ontologies/2026/3/riceMMKG#Insecticide_Application"/>
    <rdfs:comment xml:lang="en">Scirpophaga incertulas (yellow stem borer). Larvae bore into stems causing deadheart at vegetative stage and white ear at flowering stage.</rdfs:comment>
